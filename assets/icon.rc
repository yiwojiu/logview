// Resources for the Windows executable.
//
// NOTE: this file is deliberately ASCII-only. rc.exe reads a BOM-less source in the
// ANSI codepage (GBK on a Chinese Windows), so a UTF-8 comment here can be mispaired
// into other bytes and swallow the line after it -- a Chinese comment above the
// #include broke the build with "RC2104: undefined keyword or key name: VER_MAJOR".
// The reasoning behind these resources therefore lives in build.rs, which rustc
// reads as UTF-8.

// The file icon. Explorer (and "Properties -> Change Icon") reads the RT_GROUP_ICON /
// RT_ICON resources, which is a different thing from the runtime window icon set by
// ViewportBuilder::with_icon: without this resource the exe keeps the default icon.
// Path is relative to the package root -- build.rs pins rc.exe's working directory
// there. ID 1 is the Windows convention for "the main icon".
1 ICON "assets\\icon.ico"

// Version information. Explorer's "Properties -> Details" and Task Manager's detail
// tab read this; without it a user can only tell versions apart by file name.
//
// The numbers come from version.h, generated by build.rs out of Cargo.toml and found
// through the -i path. Nothing is hardcoded here on purpose: the fewer places that
// have to be updated per release the better, and a stale copy would only ever show
// up in somebody's Properties dialog.
#include "version.h"

1 VERSIONINFO
  FILEVERSION    VER_MAJOR, VER_MINOR, VER_PATCH, VER_BUILD
  PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, VER_BUILD
  // The following constants live in winver.h, but literals keep rc.exe from needing
  // the SDK include path
  FILEFLAGSMASK  0x3fL        // VS_FFI_FILEFLAGSMASK
  FILEFLAGS      0x0L         // release: no debug / prerelease bits
  FILEOS         0x40004L     // VOS_NT_WINDOWS32
  FILETYPE       0x1L         // VFT_APP
  FILESUBTYPE    0x0L         // VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    // 0804 = Chinese (Simplified), 04b0 = Unicode
    BLOCK "080404b0"
    BEGIN
      VALUE "FileDescription",  "logview - viewer for very large log files\0"
      VALUE "FileVersion",      VER_STRING
      VALUE "InternalName",     "logview\0"
      VALUE "OriginalFilename", "logview.exe\0"
      VALUE "ProductName",      "logview\0"
      VALUE "ProductVersion",   VER_STRING
      VALUE "LegalCopyright",   "iot_xush - MIT OR Apache-2.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END
